@implements IAsyncDisposable
<section id="game-container" class="game-container">
</section>

@code {
    [Inject]
    private IJSRuntime? JS { get; set; }

    private IJSObjectReference? sugarGameModule;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && JS != null)
        {
            sugarGameModule = await JS.InvokeAsync<IJSObjectReference>("import", "/Components/Programs/Sugar/SugarGame.razor.js");
            await sugarGameModule.InvokeVoidAsync("initializeSugarGame", "game-container");
        }
    }
    public async ValueTask DisposeAsync()
    {
        if (sugarGameModule != null)
        {
            await sugarGameModule.InvokeVoidAsync("disposeSugarGame", "game-container");
            await sugarGameModule.DisposeAsync();
        }
    }
}