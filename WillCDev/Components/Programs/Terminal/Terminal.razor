@using Microsoft.JSInterop
@using Shared.Services
@using WillCDev.Services.Command
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@rendermode InteractiveServer


<section class="terminal-container">
    <div class="text-scroll-panel" @onclick="FocusTerminalInput">
        @foreach (var command in consoleLines ?? [])
        {
            <div class="console-line">@command</div>
        }
    </div>
    <TerminalInput @ref="_terminalInput"/>
</section>

@code {
    [Inject]
    public required IJSRuntime JS { get; set; }

    [Inject]
    public required ICommandRegistry CommandRegistry { get; set; }

    [Inject]
    public required IServiceProvider ServiceProvider { get; set; }

    private IFeedController _feedController = new TerminalFeedController();

    private TerminalInput _terminalInput { get; set; } = default!;

    private List<string> consoleLines = new();

    protected override void OnInitialized()
    {
        _feedController.SubscribeOnLineAdded(line =>
        {
            consoleLines.Add(line);
            StateHasChanged();
        });
        _feedController.SubscribeOnCleared(() =>
        {
            consoleLines.Clear();
            StateHasChanged();
        });
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _terminalInput.RegisterInputHandler(HandleCommandSubmit);
            await FocusTerminalInput();
        }
    }

    private async Task FocusTerminalInput()
    {
        await JS.InvokeVoidAsync("FocusElement", _terminalInput.Id);
    }

    private async Task HandleCommandSubmit(string input)
    {
        var parts = input.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        var command = parts.Length > 0 ? parts[0] : string.Empty;
        var args = parts.Length > 1 ? parts[1..] : Array.Empty<string>();

        consoleLines.Add("$> " + input);
        await RouteCommand(command, args);
        StateHasChanged();
    }

    private async Task RouteCommand(string command, params string[] args)
    {
        try
        {
            var commandAttribute = CommandRegistry.GetCommand(command);
            if (commandAttribute != null)
            {
                var handler = ActivatorUtilities.CreateInstance(ServiceProvider, commandAttribute.HandlerType) as CommandHandlerBase;
                if (handler != null)
                {
                    await handler.HandleCommand(AppId, _feedController, args);
                }
            } else
            {
                _feedController.AddLine("Unrecognized Command");
            }
        } catch (Exception e)
        {
            _feedController.AddLine("Unrecognized Command");
        }
    }
}
