@using WillCDev.Services.Application
<section class="p-3">
    <p class="m-0 p-0"><b>Applications:</b></p>
    @for (var i = 0; i < _applications.Count; i++)
    {
        var app = _applications[i];
        @if (app != null)
        {
            <div>
                <label>&emsp;[]&ensp;</label>
                <button @onclick="() => OpenApplication(app)">@app?.Name</button>
            </div>
        }
    }
</section>

@code {
    [Inject]
    public required IApplicationService ApplicationService { get; set; }

    private List<Application?> _applications { get; set; } = new();

    private void OpenApplication(Application? app)
    {
        if (app == null)
            return;

        ApplicationService.StartApplication(app.Id);
    }

    protected override void OnInitialized()
    {
        _applications = (ApplicationService?.GetApplications() ?? []);
    }
}