@page "/desktop"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Authorization
@using WillCDev.Components.TaskBar
@using WillCDev.Components.Window
@using Shared.Models
@using Shared.Services

<PageTitle>Porfolio-XP</PageTitle>

<section class="desktop-container">
    <DesktopBackground/>
    <div class="desktop-windowspace">
        @for (int i = 0; i < windows.Length; i++)
        {
            <Window WindowSetting="windows[i]"/>
        }
        <div class="desktop-icons">
            @foreach (var shortcut in shortcuts)
            {
                <DesktopIcon Shortcut="shortcut" />
            }
        </div>
    </div>
    <TaskBar @ref="taskBar" />
</section>

@code {
    private int windowCount = 0;
    private ProgramWindow?[] windows { get; set; } = new ProgramWindow?[16];
    private bool bringWindowToFront = false;
    private int windowToBringToFrontId = -1;

    private List<DesktopShortcut> shortcuts = new List<DesktopShortcut>();

    private TaskBar taskBar { get; set; } = default!;

    [Inject]
    public required IJSRuntime JS { get; set; }

    [Inject]
    public required IApplicationService ApplicationService { get; set; }

    [Inject]
    public required NavigationManager NavigationManager { get; set; }

    [Inject]
    public required IAuthService AuthService { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            if (!await AuthService.IsAuthenticated())
            {
                NavigationManager.NavigateTo("/login", true);
            }

            await ApplicationService.Init();
            ApplicationService.SubscribeToBringToFrontWindows(BringWindowToFront);
            ApplicationService.SubscribeToUpdatesDesktop(UpdateDesktopIcons);
            ApplicationService.SubscribeToUpdatesWindows(UpdateWindows);

            if (taskBar != null)
                ApplicationService.SubscribeToUpdatesTaskBar(taskBar.UpdateTaskBarPrograms);

            await ApplicationService.RefreshApplicationData();
        }
    }

    private async Task InitWindows()
    {
        @* await JS.InvokeVoidAsync("InitWindows");

        if (bringWindowToFront && windowToBringToFrontId != -1)
        {
            await JS.InvokeVoidAsync("FocusWindow", windowToBringToFrontId);
            bringWindowToFront = false;
            windowToBringToFrontId = -1;
        } *@
    }

    private async Task UpdateWindows(ProgramWindow?[] updatedWindows)
    {
        windows = updatedWindows;
        windowCount = windows.Count(w => w != null);
        await InvokeAsync(StateHasChanged);
    }

    private async Task UpdateDesktopIcons(List<DesktopShortcut> updatedShortcuts)
    {
        shortcuts = updatedShortcuts;
        await InvokeAsync(StateHasChanged);
    }

    private async Task BringWindowToFront(int windowId)
    {
        var windowToBringToFront = windows.FirstOrDefault(w => w?.ID == windowId);
        if (windowToBringToFront != null)
        {
            await JS.InvokeVoidAsync("FocusWindow", windowId);
        }
    }
}
    