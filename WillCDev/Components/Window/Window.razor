
@rendermode InteractiveServer
@using WillCDev.Components.Programs.StartMenu
@using WillCDev.Components.UI
@using Shared.Attributes
@using Shared.Models
@using Shared.Services

@if (WindowSetting != null && ProgramAttribute?.ComponentType != typeof(StartMenu))
{
    <section id="@WindowSetting.ID" class="window-frame start draggable">
        <div class="title-bar">
            <div class="window-icon">
                <Icon IconName="Application Window" />
            </div>
            <div class="window-title">
                @WindowSetting?.WindowTitle
            </div>
            
            <div class="window-button">
                <Icon IconName="Minimize" />
            </div>
            <div class="window-button">
                <Icon IconName="Maximize" />
            </div>
            <div class="window-button" @onclick="OnCloseWindow">
                <Icon IconName="Exit" />
            </div>

        </div>
        <div class="window-body" >
            @if (ProgramAttribute != null)
            {
                <DynamicComponent Type="@ProgramAttribute.ComponentType" />
            }
            else
            {
                @("Program not found")
            }
        </div>
    </section>
} else if (WindowSetting != null && ProgramAttribute?.ComponentType == typeof(StartMenu))
{
        <div id="@WindowSetting.ID" class="start-menu-frame start">
            <StartMenu />
        </div>
        <section class="window-click-catcher" @onclick="OnCloseWindow"></section>
}

@code {

    [Inject]
    public required IApplicationService ApplicationService { get; set; }

    [Inject]
    public required IProgramRegistry ProgramRegistry { get; set; }

    [Inject]
    public required IJSRuntime JS { get; set; }

    [Parameter]
    public ProgramWindow? WindowSetting { get; set; }

    public string WindowTitle { get; set; } = "Window Title";

    private ProgramAttribute? ProgramAttribute { get; set; }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender && ProgramAttribute?.ShrinkWindowOnLoad == true)
        {
            JS.InvokeVoidAsync("ShrinkWindow", WindowSetting?.ID);
        }
    }

    protected override void OnParametersSet()
    {
        if (WindowSetting != null)
        {
            ProgramAttribute = ProgramRegistry.GetProgram(WindowSetting.ProgramId);
        }
    }

    private async Task OnCloseWindow()
    {
        if (WindowSetting != null)
        {
            int waitMilliseconds = await JS.InvokeAsync<int>("CloseWindow", WindowSetting.ID);
            await Task.Delay(waitMilliseconds);
            await ApplicationService.StopApplication(WindowSetting.AppId);
        }
    }
}
