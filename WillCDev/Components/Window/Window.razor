
@rendermode InteractiveServer
@using WillCDev.Components.UI

@if (WindowSetting != null && WindowSetting.Program != Programs.StartMenu)
{
    <section class="window-frame draggable">
        <div class="title-bar">
            <div class="window-icon">
                <Icon IconName="Application Window" />
                </div>
            <div class="window-title">
                @WindowSetting?.WindowTitle
                </div>
            <div class="window-exit" @onclick="OnCloseWindow">
                X
                </div>
        </div>
        <div class="window-body" >
            @if (WindowSetting?.Program == Programs.AboutMe)
            {
                @("About Me coming soon!")
            }
            else if (WindowSetting?.Program == Programs.Projects)
            {
                @("Projects coming soon!")
            }
            else if (WindowSetting?.Program == Programs.Contact)
            {
                @("Contact form coming soon!")
            }
            else if (WindowSetting?.Program == Programs.WindowLimitReached)
            {
                <WindowLimitReached />
            }
            else
            {
                @("Program not found")
            }
        </div>
    </section>
} else if (WindowSetting != null && WindowSetting.Program == Programs.StartMenu)
{
    <section class="window-click-catcher" @onclick="OnCloseWindow">
        <div class="start-menu-frame">
            
        </div>
    </section>
}

@code {
    [Inject]
    private IWindowService WindowService { get; set; } = default!;

    [Parameter]
    public ProgramWindow? WindowSetting { get; set; }

    public string WindowTitle { get; set; } = "Window Title";

    private void OnCloseWindow()
    {
        if (WindowSetting != null)
        {
            WindowService.CloseWindow(WindowSetting.ID);
        }
    }
}
