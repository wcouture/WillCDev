
@rendermode InteractiveServer
@using WillCDev.Components.Programs
@using WillCDev.Components.UI
@using WillCDev.Services.ApplicationService
@using WillCDev.Services.TaskbarService
@using WillCDev.Services.WindowService

@if (WindowSetting != null && WindowSetting.Program != EProgram.StartMenu)
{
    <section id="@WindowSetting.ID" class="window-frame draggable">
        <div class="title-bar">
            <div class="window-icon">
                <Icon IconName="Application Window" />
                </div>
            <div class="window-title">
                @WindowSetting?.WindowTitle
                </div>
            <div class="window-exit" @onclick="OnCloseWindow">
                X
                </div>
        </div>
        <div class="window-body" >
            @if (WindowSetting?.Program == EProgram.AboutMe)
            {
                <AboutMe/>
            }
            else if (WindowSetting?.Program == EProgram.Projects)
            {
                <Projects/>
            }
            else if (WindowSetting?.Program == EProgram.Contact)
            {
                <ContactMe/>
            }
            else if (WindowSetting?.Program == EProgram.WindowLimitReached)
            {
                <WindowLimitReached />
            }
            else if (WindowSetting?.Program == EProgram.Settings)
            {
                <Settings />
            }
            else
            {
                @("Program not found")
            }
        </div>
    </section>
} else if (WindowSetting != null && WindowSetting.Program == EProgram.StartMenu)
{
    <section class="window-click-catcher" @onclick="OnCloseWindow">
        <div class="start-menu-frame">
            <StartMenu />
        </div>
    </section>
}

@code {
    [Inject]
    public required IApplicationService ApplicationService { get; set; }

    [Parameter]
    public ProgramWindow? WindowSetting { get; set; }

    public string WindowTitle { get; set; } = "Window Title";

    private async Task OnCloseWindow()
    {
        if (WindowSetting != null)
        {
            await ApplicationService.StopApplication(WindowSetting.AppId);
        }
    }
}
