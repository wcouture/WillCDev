@using WillCDev.Components.UI
@using WillCDev.Components.Window
@using WillCDev.Services.ApplicationService
@using WillCDev.Services.TaskbarService
@using WillCDev.Services.WindowService

<div class="icon-container @(IsActive ? "active" : "")" @onclick="OpenWindow">
    <div class="@(_isStartMenu ? "task-icon start" : "task-icon")">
        <Icon IconName="@IconName" IconSize="@_iconSizeRel" />
        @if (IconText?.Length > 0)
        {
            <p class="icon-text">@IconText</p>
        }
    </div>
</div>

@code {

    [Parameter]
    public string IconName { get; set; } = "Internet Explorer 6";

    [Parameter]
    public string IconText { get; set; } = "";

    [Parameter]
    public int AppId { get; set; } = -1;

    [Parameter]
    public bool IsActive { get; set; } = false;

    [Inject]
    public required IApplicationService ApplicationService { get; set; }

    private bool _isStartMenu { get; set; } = false;
    private int _iconSizeRel { get; set; } = 100;

    private async Task OpenWindow() => await ApplicationService.StartApplication(AppId);

    protected override void OnInitialized()
    {
        if (IconName == "start")
        {
            _isStartMenu = true;
            _iconSizeRel = 70;
            IconText = "START";
        }
    }
}
