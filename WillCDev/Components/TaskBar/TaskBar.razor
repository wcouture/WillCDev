@using WillCDev.Components.Window
@using WillCDev.Services.TaskbarService
<div class="task-bar-body">
    @foreach (var taskBarProgram in taskBarPrograms)
    {
        <TaskBarIcon IconName="@taskBarProgram.IconName" AppId="@taskBarProgram.AppId" IsActive="@taskBarProgram.IsActive"/>
    }
</div>
@code {
    private List<TaskBarProgram> taskBarPrograms = new List<TaskBarProgram>();

    public async Task UpdateTaskBarPrograms(List<TaskBarProgram> updatedTaskBarPrograms)
    {
        taskBarPrograms = updatedTaskBarPrograms;
        await InvokeAsync(StateHasChanged);
    }
}
