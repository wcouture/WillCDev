@page "/login"
@rendermode InteractiveServer
@using System.Net
@using Microsoft.AspNetCore.Components.Authorization
@using Shared.Services
@using WillCDev.Components.UI

@inject NavigationManager NavigationManager

<PageTitle>Login</PageTitle>

<div class="xp-login-screen">
    <div class="xp-login-dialog">
        <div class="xp-titlebar">
            <span>Log On to Windows</span>
            <button type="button" aria-label="Close" @onclick="HandleCancel">x</button>
        </div>

        <div class="xp-dialog-body">
            <div class="xp-user-box">
                <div class="xp-user-icon" aria-hidden="true">👤</div>
                <div class="xp-form">
                    <label for="username">User name</label>
                    <input id="username" type="text" @bind="username" />

                    <label for="password">Password</label>
                    <input id="password" type="password" @bind="password" />
                </div>
            </div>

            <div class="xp-bottom-row">
                @if (isLoading)
                {
                    <Spinner/>
                }
                else
                {
                    <div class="xp-error-message">@errorMessage</div>
                }
                <div class="xp-actions">
                    <button type="button" class="xp-button primary" @onclick="HandleLogin">Login</button>
                    <button type="button" class="xp-button primary" @onclick="HandleRegister">Register</button>
                </div>
            </div>
        </div>
    </div>
</div>

@code {

    [Inject]
    public required IAuthService AuthService { get; set; }
    [Inject]
    public required AuthenticationStateProvider AuthenticationStateProvider { get; set; }
    [Inject]
    public required IHttpClientFactory HttpClientFactory { get; set; }
    [Inject]
    public required IJSRuntime JS { get; set; }

    private bool isLoading { get; set; } = false;

    private string username {get; set;} = string.Empty;
    private string password {get; set;} = string.Empty;

    private string errorMessage { get; set; } = string.Empty;

    private async Task HandleLogin()
    {
        isLoading = true;
        await Task.Delay(500);

        var result = await AuthService.Login(username, password);
        if (result == HttpStatusCode.OK)
        {
            NavigationManager.NavigateTo("/desktop");
            return;
        }
        else
        {
            // Handle login failure (e.g., show an error message)
            errorMessage = $"Login failed ({result})";
        }

        isLoading = false;
    }

    private void HandleRegister()
    {
        NavigationManager.NavigateTo("/register");
    }

    private async Task HandleCancel()
    {
        await JS.InvokeVoidAsync("window.close");
    }

    protected async override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && await AuthService.IsAuthenticated())
            NavigationManager.NavigateTo("/", true);
    }
}
